# Every 6 hours — credentials are capped at a 24h TTL (Cloudflare's actual
# max, confirmed empirically; longer requests get rejected), so this cadence
# still tolerates a missed run or two before anything actually expires.
[Unit]
Description=Renew MediaMTX's Cloudflare Realtime TURN credentials

[Timer]
OnCalendar=*-*-* 00,06,12,18:00:00
Persistent=true

[Install]
WantedBy=timers.target
