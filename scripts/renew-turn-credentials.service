# Renews MediaMTX's static Cloudflare Realtime TURN/STUN credentials.
# Install:
#   sudo cp scripts/renew-turn-credentials.service scripts/renew-turn-credentials.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now renew-turn-credentials.timer
# Requires TURN_KEY_ID and TURN_KEY_API_TOKEN in ~/.seagrass-env.
# Logs: journalctl -u renew-turn-credentials

[Unit]
Description=Renew MediaMTX's Cloudflare Realtime TURN credentials

[Service]
Type=oneshot
User=root
EnvironmentFile=/home/pi/.seagrass-env
ExecStart=/usr/bin/python3 /home/pi/Sea-Grass-Drone/scripts/renew-turn-credentials.py
