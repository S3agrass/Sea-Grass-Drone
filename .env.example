# .env Template

# Firebase Configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Supabase — fleet registry and captured media (photos/recordings).
# Firebase Cloud Storage requires the paid Blaze plan; Supabase's free tier
# gives 1 GB with no card, which is why media lives there.
# Project settings -> API. The anon key is public and safe to ship in the bundle;
# the service_role key is NOT — that one goes only on the Pi.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
