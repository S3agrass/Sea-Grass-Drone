# .env Template

# Supabase — sign-in, the fleet registry, and captured media.
#
# Auth used to be Firebase. It moved here because the data was already in
# Supabase and Postgres had no way to know who the Firebase user was: inside
# RLS, auth.uid() was always NULL, so the only policies that worked at all were
# `using (true)` — and every account saw every other account's fleet. Signing
# in to Supabase itself is what makes per-user isolation enforceable.
#
# Firebase HOSTING is unaffected and needs no keys here (see firebase.json).
#
# Project settings -> API. The anon key is public and safe to ship in the bundle;
# the service_role key is NOT — that one goes only on the Pi.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
