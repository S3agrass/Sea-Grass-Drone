# Local-only perception prototype (sonar dodge + camera/YOLO) — not yet
# validated on hardware, intentionally kept out of git until it works.
perception/

__pycache__/
*.pyc__pycache__/
*.pyc
server/vision/models/*.onnx

# Training data and artifacts. The prepared dataset is ~3.5GB of JPEGs across
# ~20k files, and GitHub rejects pushes this size — one `git add -A` would wedge
# the repo. Nothing here is source: prepare_dataset.py rebuilds all of it from
# the public RUOD/TrashCan downloads, deterministically. The README.txt files
# documenting the expected layout are kept.
training/datasets/*/train2017/*
training/datasets/*/val2017/*
training/datasets/*/train2024/*
training/datasets/*/val2024/*
training/datasets/*/annotations/*.json
!training/datasets/*/*/README.txt
training/yolox_nano.pth
training/yolox_src/
training/YOLOX_outputs/
# Dataset archives. The rules above only cover the unpacked directories, so a
# zip made for a Drive upload sat outside them and got committed — 3.7GB against
# GitHub's 100MB per-file limit, which does not fail fast, it just retries the
# push forever.
training/*.zip
training/*.tar
training/*.tar.gz

# MAVLink session capture artifacts (runtime, not source)
*.tlog
*.tlog.raw
*.parm

# local camera simulation artifacts
sim/media/
sim/*.log
